{{$mayAdd := May "ban.add" $.Account $.Opt.Access}}
{{$mayUpdate := or (May "ban.shorten" $.Account $.Opt.Access) (May "ban.lengthen" $.Account $.Opt.Access)}}
{{if or (and (eq .Manage.Ban nil) $mayAdd) (and (ne .Manage.Ban nil) $mayUpdate)}}
        <fieldset style="position: relative;">
        <legend>
            {{if eq .Manage.Ban nil}}{{T "Add Ban"}}{{else}}{{T "Update"}} #{{.Manage.Ban.ID}} - {{.Manage.Ban.TypeLabel}}{{end}}
            {{if and (May "ban.shorten" $.Account $.Opt.Access) (ne .Manage.Ban nil)}}
                <form method="post" action="/sriracha/ban/lift/{{.Manage.Ban.ID}}" onsubmit="javascript:return liftBan('{{.Manage.Ban.ID}}')">
                    <input type="hidden" name="reason" id="reason{{.Manage.Ban.ID}}">
                    &nbsp; <input type="submit" value="{{T "Lift"}}" style="position: absolute;right: 10px;">
                </form>
            {{end}}
        </legend>
    <form name="sriracha" method="post">
        {{if ne .Extra ""}}
        <input type="hidden" name="confirmation" value="1">
        {{end}}
        <input type="submit" hidden>
        <table class="manageform">
            {{if and (eq .Manage.Ban nil) (eq .Extra "")}}
                <tr>
                    <td class="postblock"><label for="ip">{{T "IP Address"}}</label></td>
                    <td><input type="text" name="ip"></td>
                    <td>{{T "IP address to ban. Wildcards (*) may be used to ban a range of addresses."}}</td>
                </tr>
            {{end}}
            <tr>
                <td class="postblock"><label for="expire">{{T "Expires"}}</label></td>
                <td><input type="text" name="expire" value="{{if ne .Manage.Ban nil}}{{FormatDateInput .Manage.Ban.Expire}}{{end}}"></td>
                <td><small><button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 3600)}}';document.sriracha.reason.focus();return false;">{{T "1 Hour"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 86400)}}';document.sriracha.reason.focus();return false;">{{T "1 Day"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 172800)}}';document.sriracha.reason.focus();return false;">{{T "2 Days"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 604800)}}';document.sriracha.reason.focus();return false;">{{T "1 Week"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 1209600)}}';document.sriracha.reason.focus();return false;">{{T "2 Weeks"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 2592000)}}';document.sriracha.reason.focus();return false;">{{T "1 Month"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='';document.sriracha.reason.focus();return false;">{{T "Never"}}</button></small></td>
            </tr>
            <tr>
                <td class="postblock"><label for="reason">{{T "Reason"}}</label></td>
                <td><input type="text" name="reason" value="{{if ne .Manage.Ban nil}}{{.Manage.Ban.Reason}}{{end}}"></td>
                <td>{{T "Message shown when the visitor attempts to post. Optional."}}</td>
            </tr>
            {{if and (May "banfile.add" $.Account $.Opt.Access) (and (and (eq .Manage.Ban nil) (ne .Extra "") (ne .Extra2 "")))}}
                <tr>
                    <td class="postblock"><label for="banfile">{{T "File"}}</label></td>
                    <td><label><input type="checkbox" name="banfile" value="{{.Extra2}}"> {{T "Ban file"}}</label></td>
                    <td>{{T "Permanently ban uploaded file."}}</td>
                </tr>
            {{end}}
            <tr>
                <td>&nbsp;</td>
                <td align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{if eq .Manage.Ban nil}}{{if eq .Template "manage_mod"}}{{if eq .Extra "db"}}{{T "Delete & ban"}}{{else}}{{T "Ban"}}{{end}}{{else}}{{T "Add"}}{{end}}{{else}}{{T "Update"}}{{end}}"></td>
                <td>&nbsp;</td>
            </tr>
        </table>
        </fieldset>
    </form><br>
    {{if or (ne .Manage.Ban nil) (ne .Template "manage_ban")}}
        <script type="text/javascript">
            if (document.sriracha.ip) {
                document.sriracha.ip.focus();
            } else {
                document.sriracha.expire.focus();
            }
        </script>
    {{end}}
{{end}}
{{if and (May "banfile.lift" $.Account $.Opt.Access) (and (eq .Manage.Ban nil) (eq .Extra ""))}}{{/* Admin */}}
    <br>
    <form method="post" enctype="multipart/form-data">
        <fieldset>
        <legend>{{T "Lift File Ban"}}</legend>
        <table class="manageform">
            <tr>
                <td class="postblock"><label for="liftfile">{{T "File"}}</label></td>
                <td><input type="file" name="liftfile"></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{T "Lift"}}"></td>
                <td>&nbsp;</td>
            </tr>
        </table>
        </fieldset>
    </form><br>
{{end}}
{{if and (May "ban.shorten" $.Account $.Opt.Access) (and (eq .Manage.Ban nil) (eq .Extra ""))}}{{/* Admin */}}
    <br>
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="search" value="1">
        <fieldset>
        <legend>{{T "Search"}}</legend>
        <table class="manageform">
            <tr>
                <td class="postblock"><label for="id">{{T "Ban ID"}}</label></td>
                <td><input type="text" name="id"></td>
                <td>&nbsp;</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{T "Search"}}"></td>
                <td>&nbsp;</td>
            </tr>
        </table>
        </fieldset>
    </form><br>
{{end}}
