{{$mayAdd := May "ban.add" $.Account $.Opt.Access}}
{{$mayUpdate := or (May "ban.shorten" $.Account $.Opt.Access) (May "ban.lengthen" $.Account $.Opt.Access)}}
{{if or (and (eq .Manage.Ban nil) $mayAdd) (and (ne .Manage.Ban nil) $mayUpdate)}}
    <fieldset style="position: relative;">
        <legend>
            {{if eq .Manage.Ban nil}}{{T "Add Ban"}}{{else}}{{T "Update"}} #{{.Manage.Ban.ID}} - {{.Manage.Ban.TypeLabel}}{{end}}
            {{if and (May "ban.shorten" $.Account $.Opt.Access) (ne .Manage.Ban nil)}}
                <form method="post" action="/sriracha/ban/lift/{{.Manage.Ban.ID}}" onsubmit="javascript:return liftBan('{{.Manage.Ban.ID}}')">
                    <input type="hidden" name="reason" id="reason{{.Manage.Ban.ID}}">
                    &nbsp; <input type="submit" value="{{T "Lift"}}" style="position: absolute;right: 10px;">
                </form>
            {{end}}
        </legend>
        <form name="sriracha" method="post">
        {{if ne .Extra ""}}
        <input type="hidden" name="confirmation" value="1">
        {{end}}
        <input type="submit" hidden>
        <div class="managegrid">
            {{if and (eq .Manage.Ban nil) (eq .Extra "")}}
                <div class="postblock"><label for="ip">{{T "IP Address"}}</label></div>
                <div><input type="text" name="ip"></div>
                <div>{{T "IP address to ban. Wildcards (*) may be used to ban a range of addresses."}}</div>
            {{end}}

            <div class="postblock"><label for="expire">{{T "Expires"}}</label></div>
            <div><input type="text" name="expire" value="{{if ne .Manage.Ban nil}}{{FormatDateInput .Manage.Ban.Expire}}{{end}}"></div>
            <div><small><button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 3600)}}';document.sriracha.reason.focus();return false;">{{T "1 Hour"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 86400)}}';document.sriracha.reason.focus();return false;">{{T "1 Day"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 172800)}}';document.sriracha.reason.focus();return false;">{{T "2 Days"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 604800)}}';document.sriracha.reason.focus();return false;">{{T "1 Week"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 1209600)}}';document.sriracha.reason.focus();return false;">{{T "2 Weeks"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='{{FormatDateInput (Add64 Now 2592000)}}';document.sriracha.reason.focus();return false;">{{T "1 Month"}}</button>&nbsp;<button onclick="document.sriracha.expire.value='';document.sriracha.reason.focus();return false;">{{T "Never"}}</button></small></div>

            <div class="postblock"><label for="reason">{{T "Reason"}}</label></div>
            <div><input type="text" name="reason" value="{{if ne .Manage.Ban nil}}{{.Manage.Ban.Reason}}{{end}}"></div>
            <div>{{T "Message shown when the visitor attempts to post. Optional."}}</div>

            {{if and (May "banfile.add" $.Account $.Opt.Access) (and (and (eq .Manage.Ban nil) (ne .Extra "") (ne .Extra2 "")))}}
                <div class="postblock"><label for="banfile">{{T "File"}}</label></div>
                <div><label><input type="checkbox" name="banfile" value="{{.Extra2}}"> {{T "Ban file"}}</label></div>
                <div>{{T "Permanently ban uploaded file."}}</div>
            {{end}}

            <div>&nbsp;</div>
            <div align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{if eq .Manage.Ban nil}}{{if eq .Template "manage_mod"}}{{if eq .Extra "db"}}{{T "Delete & ban"}}{{else}}{{T "Ban"}}{{end}}{{else}}{{T "Add"}}{{end}}{{else}}{{T "Update"}}{{end}}"></div>
            <div>&nbsp;</div>
        </div>
        </form>
    </fieldset><br>
    {{if or (ne .Manage.Ban nil) (ne .Template "manage_ban")}}
        <script type="text/javascript">
            if (document.sriracha.ip) {
                document.sriracha.ip.focus();
            } else {
                document.sriracha.expire.focus();
            }
        </script>
    {{end}}
{{end}}
{{if gt (len .Manage.LiftedBans) 0}}
    <br><table class="managetable">
        <tr><th colspan="5" style="border: 0px none;">{{TN "%d previous ban" "%d previous bans" (len .Manage.LiftedBans)}}</th></tr>
        <tr>
            <th>{{T "Added"}}</th>
            <th>{{T "Reason"}}</th>
            <th>{{T "Lifted"}}</th>
            <th>{{T "Reason"}}</th>
            <th>{{T "Duration"}}</th>
        </tr>
        {{range $i, $ban := .Manage.LiftedBans}}
            <tr>
                <td>{{FormatYYMMDD $ban.Timestamp}}</td>
                <td>{{$ban.Reason}}</td>
                <td>{{FormatYYMMDD $ban.LiftedTimestamp}}</td>
                <td>{{$ban.LiftedReason}}</td>
                <td>{{$ban.Duration}}</td>
            </tr>
        {{end}}
    </table>
{{end}}
{{if and (May "banfile.lift" $.Account $.Opt.Access) (and (eq .Manage.Ban nil) (eq .Extra ""))}}{{/* Admin */}}
    <br><form method="post" enctype="multipart/form-data">
        <fieldset>
        <legend>{{T "Lift File Ban"}}</legend>
        <div class="managegrid">
            <div class="postblock"><label for="liftfile">{{T "File"}}</label></div>
            <div><input type="file" name="liftfile"></div>
            <div>&nbsp;</div>

            <div>&nbsp;</div>
            <div align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{T "Lift"}}"></div>
            <div>&nbsp;</div>
        </div>
        </fieldset>
    </form><br>
{{end}}
{{if and (May "ban.shorten" $.Account $.Opt.Access) (and (eq .Manage.Ban nil) (eq .Extra ""))}}{{/* Admin */}}
    <br>
    <form method="post" enctype="multipart/form-data">
        <input type="hidden" name="search" value="1">
        <fieldset>
        <legend>{{T "Search"}}</legend>
        <div class="managegrid">
            <div class="postblock"><label for="id">{{T "Ban ID"}}</label></div>
            <div><input type="text" name="id"></div>
            <div>&nbsp;</div>

            <div>&nbsp;</div>
            <div align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{T "Search"}}"></div>
            <div>&nbsp;</div>
        </div>
        </fieldset>
    </form><br>
{{end}}
