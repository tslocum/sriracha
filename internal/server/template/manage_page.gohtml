{{template "manage_begin.gohtml" .}}
{{$mayAdd := May "page.add" $.Account $.Opt.Access}}
{{$mayUpdate := May "page.update" $.Account $.Opt.Access}}
{{$mayDelete := May "page.delete" $.Account $.Opt.Access}}
<h2 class="managetitle">{{T "Pages"}}</h2>
{{if ne (len .Manage.Pages) 0}}
    <table class="managetable">
        <tr>
            <th>{{T "Path"}}</th>
            {{if or $mayUpdate $mayDelete}}
                <th>{{T "Action"}}</th>
            {{end}}
        </tr>
        {{range $i, $page := .Manage.Pages}}
            <tr>
                <td><a href="{{$page.URL}}">{{$page.Path}}</a></td>
                {{if or $mayUpdate $mayDelete}}
                    <td>
                        {{if $mayUpdate}}
                            <form method="get" action="/sriracha/page/{{$page.ID}}"><input type="submit" value="{{T "Update"}}"></form>
                            <form method="get" action="/sriracha/page/rebuild/{{$page.ID}}"><input type="submit" value="{{T "Rebuild"}}"></form>
                        {{end}}
                        {{if $mayDelete}}
                            <form method="get" action="/sriracha/page/delete/{{$page.ID}}" onsubmit="javascript:return confirm('Delete {{$page.Path}}?');"><input type="submit" value="{{T "Delete"}}"></form>
                        {{end}}
                    </td>
                {{end}}
            </tr>
        {{end}}
    </table><br>
    {{if gt .Pages 1}}
        <table class="navtable">
            <tbody>
                <tr>
                    <td>
                        {{if gt .Page 0}}
                            <form method="get" action="/sriracha/page/{{if gt .Page 1}}p{{.Page | MinusOne}}{{end}}">
                                <input type="submit" value="{{T "Previous"}}">
                            </form>
                        {{else}}
                            {{T "Previous"}}
                        {{end}}
                    </td>
                    <td>
                        {{range $i := Iterate (.Pages | MinusOne)}}
                            [{{if eq $i $.Page}}{{$i}}{{else}}<a href="/sriracha/page/{{if gt $i 0}}p{{$i}}{{end}}">{{$i}}</a>{{end}}]
                        {{end}}
                    </td>
                    <td>
                        {{if lt .Page (.Pages | MinusOne)}}
                            <form method="get" action="/sriracha/page/p{{.Page | PlusOne}}">
                                <input type="submit" value="{{T "Next"}}">
                            </form>
                        {{else}}
                            {{T "Next"}}
                        {{end}}
                    </td>
                </tr>
            </tbody>
        </table><br><br>
    {{end}}
    {{if and (gt (len .Manage.Pages) 1) $mayUpdate}}
        <form method="get" action="/sriracha/page/rebuild/0"><input type="submit" value="{{T "Rebuild All"}}"></form><br><br>
    {{end}}
{{end}}
{{if or (and (eq .Manage.Page.ID 0) $mayAdd) (and (ne .Manage.Page.ID 0) $mayUpdate)}}
    {{if eq .Manage.Page.ID 0}}
        <br>
        <details>
            <summary>{{T "Add Page"}}</summary>
            <div>
    {{else}}
        [<a href="/sriracha/page/">{{T "Return"}}</a>]<br>
    {{end}}
    <form method="post">
        <fieldset>
        {{if and (ne .Manage.Page nil) (ne .Manage.Page.ID 0)}}
            <legend>{{T "Update"}} {{.Manage.Page.Path}}</legend>
        {{end}}
        <table class="manageform">
            <tr>
                <td class="postblock"><label for="path">{{T "Path"}}</label></td>
                <td><input type="text" name="path" value="{{if ne .Manage.Page nil}}{{.Manage.Page.Path}}{{end}}"></td>
                <td>{{T "Relative file path where the page is located, excluding the .html suffix."}}</td>
            </tr>
            <tr>
                <td class="postblock"><label for="content">{{T "Content"}}</label></td>
                <td><textarea name="content" rows="24" cols="80">{{if ne .Manage.Page nil}}{{.Manage.Page.Content}}{{end}}</textarea></td>
                <td>{{T "HTML content of the page. Go HTML template actions are supported."}}</td>
            </tr>
            <tr>
                <td>&nbsp;</td>
                <td align="right">
                    <table width="100%" style="border: 0px none;">
                        <tr>
                            <td width="50%">
                                <input type="submit" class="managebutton" name="preview" value="{{T "Preview"}}">
                            </td>
                            <td width="50%">
                                <input type="submit" class="managebutton" value="{{if or (eq .Manage.Page nil) (eq .Manage.Page.ID 0)}}{{T "Add"}}{{else}}{{T "Update"}}{{end}}">
                            </td>
                        </tr>
                    </table>
                </td>
                <td>&nbsp;</td>
            </tr>
        </table>
        </fieldset>
    </form>
    {{if eq .Manage.Page.ID 0}}
        </div>
    </details>
    {{end}}
    <br>
{{end}}
{{template "manage_end.gohtml" .}}
