{{template "manage_begin.gohtml" .}}
<h2 class="managetitle">{{T "Preferences"}}</h2>
<form method="post">
    <input type="hidden" name="action" value="password">
	<fieldset>
        <legend>{{T "Change Password"}}</legend>
        <table border="0" class="manageform">
            <tr><td class="postblock">{{T "Current"}}</td><td><input type="password" name="old"></td></tr>
            <tr><td class="postblock">{{T "New"}}</td><td><input type="password" name="new"></td></tr>
            <tr><td class="postblock">{{T "New (confirm)"}}</td><td><input type="password" name="confirmation"></td></tr>
            <tr><td>&nbsp;</td><td align="right"><input type="submit" class="managebutton" style="width: 100%;" value="{{T "Change Password"}}"></td></tr>
        </table>
        <legend>
	</fieldset>
</form><br><br>
<form method="post">
    <input type="hidden" name="action" value="style">
	<fieldset>
        <legend>{{T "Change Style"}}</legend>
        <table border="0" class="manageform">
            <tr>
                <td class="postblock">{{T "Style"}}</td>
                <td>
                    <select name="style">
                        <option value=""{{if eq .Account.Style ""}} selected{{end}}>Futaba</option>
                        <option value="burichan"{{if eq .Account.Style "burichan"}} selected{{end}}>Burichan</option>
                        <option value="sriracha"{{if eq .Account.Style "sriracha"}} selected{{end}}>Sriracha</option>
                    </select>
                </td>
            </tr>
            <tr><td>&nbsp;</td><td align="right"><input type="submit" class="managebutton" style="width: 100%;" value="{{T "Change Style"}}"></td></tr>
        </table>
        <legend>
	</fieldset>
</form><br><br>
<form method="post">
    <input type="hidden" name="action" value="locale">
	<fieldset>
        <legend>{{T "Change Locale"}}</legend>
        <table border="0" class="manageform">
            <tr>
                <td class="postblock">{{T "Locale"}}</td>
                <td>
                    <select name="locale">
                        <option value=""{{if eq .Account.Locale ""}} selected{{end}}>{{T "Default"}} ({{.Opt.DefaultLocaleName}})</option>
                        {{range $i, $localeID := .Opt.LocalesSorted}}
                            <option value="{{$localeID}}"{{if eq $.Account.Locale $localeID}} selected{{end}}>{{index $.Opt.Locales $localeID}}</option>
                        {{end}}
                    </select>
                </td>
                {{if or (and (ne .Account.Locale "") (ne .Account.Locale "en")) (and (ne .Opt.Locale "en") (eq .Account.Locale ""))}}
                    <td>
                        <a href="https://translate.codeberg.org/projects/sriracha/sriracha/" target="_blank">{{T "Help translate Sriracha"}}</a>
                    </td>
                {{end}}
            </tr>
            <tr><td>&nbsp;</td><td align="right"><input type="submit" class="managebutton" style="width: 100%;" value="{{T "Change Locale"}}"></td></tr>
        </table>
        <legend>
	</fieldset>
</form><br><br>
<fieldset>
    <legend>{{T "Documentation"}}</legend>
    <div>
        <ul style="margin: 0;">
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#moderator-guide">Moderator</a></li>
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#administrator-guide">Administrator</a></li>
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#install">Install</a></li>
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#configure">Configure</a></li>
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#migrate">Migrate</a></li>
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#upgrade">Upgrade</a></li>
            <li><a href="https://codeberg.org/tslocum/sriracha/src/branch/main/MANUAL.md#plugins">Plugins</a></li>
        </ul>
    </div>
</fieldset><br>
{{template "manage_end.gohtml" .}}
