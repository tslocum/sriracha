{{if .ReplyMode}}{{template "imgboard_page.gohtml" .}}{{else}}{{template "forum_begin.gohtml" .}}
	{{if .Preview}}
		<div class="replymode">{{T "Posting mode: Preview"}}</div>
	{{else if .ReplyMode}}
		{{if not .ModMode}}
			<div class="replymode">{{T "Posting mode: Reply"}}</div>
		{{else}}
			<div class="replymode">{{T "Mod mode: Reply"}}</div>
		{{end}}
	{{else if .ModMode}}
		<div class="replymode">{{T "Mod mode"}}</div>
	{{end}}
	{{if gt .Board.ID 0}}
		{{if ne .Message ""}}
			{{.Message}}
			<hr>
		{{else}}
			{{if $.Preview}}
				{{if eq .Extra "thumb"}}{{T "Only thumbnails are displayed."}}{{end}}
				{{T "Go back, uncheck '%s' and resubmit to post." (T "Preview")}}
			{{else if not .ArchiveMode}}
				<details id="postdetails">
					<summary>{{if eq .ReplyMode 0}}{{T "Post thread"}}{{else}}{{T "Post reply"}}{{end}}</summary>
					<div>
						{{template "imgboard_postarea.gohtml" .}}
					</div>
				</details>
			{{end}}
			<hr>
		{{end}}
	{{end}}
	<form method="post" action="/sriracha/">
		<input type="hidden" name="action" value="delete">
		<input type="hidden" name="board" value="{{.Board.Dir}}">
		{{if ne .ReplyMode 0}}
			<input type="hidden" name="thread" value="{{.ReplyMode}}">
		{{end}}
		{{template "forum_post.gohtml" .}}
		{{if and (and (ne .ReplyMode 0) (not .ModMode)) (not $.Preview)}}
			<br>
			{{if .Opt.Notifications}}
				<input type="submit" name="subscribe" value="{{T "Subscribe"}}"><br>
			{{end}}
			<details class="fadedetails">
				<summary style="margin-right: 2px;">
					{{T "Delete Post"}}
				</summary>
				<div class="replyhl" style="display: inline-block;padding: 4px;">
					{{if $.ModMode}}
						<input type="submit" name="moderate" value="{{T "Moderate"}}">
					{{else}}
						<input type="password" name="password" id="deletepostpassword" size="8" placeholder="{{T "Password"}}" autocomplete="off"> <input type="submit" id="deletepost" name="deletepost" value="{{T "Delete"}}">
					{{end}}
				</div>
			</details>
		{{end}}
	</form>
	<hr>
	{{if not $.Preview}}
		<table class="navtable">
			<tbody>
				<tr>
					{{if eq .ReplyMode 0}}
						<td>{{if gt .Page 0}}<form method="get" action="{{if not $.ModMode}}{{.Board.Path}}{{if eq .Page 1}}{{if not .ArchiveMode}}index{{else}}archive{{end}}{{else}}{{if .ArchiveMode}}archive-{{.Page | MinusOne}}{{else}}{{.Page | MinusOne}}{{end}}{{end}}.html{{else}}/sriracha/board/mod/{{$.Board.ID}}{{if ne .Page 1}}p{{.Page | MinusOne}}{{end}}{{end}}">{{if and .ModMode .ArchiveMode}}<input type="hidden" name="archive" value="1">{{end}}<input type="submit" value="{{T "Previous"}}"></form>{{else}}{{T "Previous"}}{{end}}</td>
						<td>
							{{range $i := Iterate (.Pages | MinusOne)}}
								[{{if eq $i $.Page}}{{$i}}{{else}}<a href="{{if not $.ModMode}}{{$.Board.Path}}{{if eq $i 0}}{{if not $.ArchiveMode}}index{{else}}archive{{end}}{{else}}{{if $.ArchiveMode}}archive-{{$i}}{{else}}{{$i}}{{end}}{{end}}.html{{else}}/sriracha/board/mod/{{$.Board.ID}}{{if ne $i 0}}/p{{$i}}{{end}}{{if $.ArchiveMode}}?archive=1{{end}}{{end}}">{{$i}}</a>{{end}}]
							{{end}}
						</td>
						<td>{{if lt .Page (.Pages | MinusOne)}}<form method="get" action="{{if not $.ModMode}}{{.Board.Path}}{{if .ArchiveMode}}archive-{{.Page | PlusOne}}{{else}}{{.Page | PlusOne}}{{end}}.html{{else}}/sriracha/board/mod/{{$.Board.ID}}/p{{.Page | PlusOne}}{{end}}">{{if and .ModMode .ArchiveMode}}<input type="hidden" name="archive" value="1">{{end}}<input type="submit" value="{{T "Next"}}"></form>{{else}}{{T "Next"}}{{end}}</td>
						{{if and .Opt.Notifications (gt .Board.ID 0)}}
							<td style="border: 0px none;">&nbsp;</td>
							<td style="border: 0px none;">
								<form method="get" action="/sriracha/subscribe/board/{{.Board.ID}}">
									<input type="submit"{{if ne .ReplyMode 0}} name="subscribe"{{end}} value="{{T "Subscribe"}}">
								</form>
							</td>
						{{end}}
					{{else if ne $.Opt.Refresh 0}}
						<td id="postdeleted" style="display: none;border: 0px none;color: red;font-weight: bold;">{{T "Thread deleted."}}</td>
					{{end}}
				</tr>
			</tbody>
		</table>
	{{end}}
	{{template "forum_end.gohtml" .}}
{{end}}
