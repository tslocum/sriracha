{{template "manage_begin.gohtml" .}}
<h2 class="managetitle">{{T "Categories"}}{{Help "board-categories"}}</h2>
<style type="text/css">
li {
    margin-top: 7px;
    margin-bottom: 7px;
}
</style>
{{if eq .Manage.Category.ID 0}}
    {{template "manage_category_item.gohtml" (Slice $ .Categories true)}}
{{end}}
{{$name := .Manage.Category.Name}}
{{if eq $name ""}}{{$name = (Sprintf "Category #%d" .Manage.Category.ID)}}{{end}}
{{if and (eq .Extra "board") (ne .Manage.Category.ID 0)}}
    [<a href="/sriracha/category/">{{T "Return"}}</a>]<br>
    <form method="post">
        <fieldset>
        <legend>{{T "Add board to %s" $name}}</legend>
        <div class="managegrid">
            <div class="postblock"><label for="board">{{T "Board"}}</label></div>
            <div>
                <select name="board">
                    {{range $board := .Boards}}
                        <option value="{{.ID}}">{{.Path}} {{.Name}}</option>
                    {{end}}
                </select>
            </div>

            <div>&nbsp;</div>
            <div align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{T "Add"}}"></div>
        </div>
        </fieldset>
    </form>
{{else}}
    {{if or (and (eq .Manage.Category.ID 0) (May "category.add" $.Account $.Opt.Access)) (and (ne .Manage.Category.ID 0) (May "category.update" $.Account $.Opt.Access))}}
        {{if eq .Manage.Category.ID 0}}
            <br>
            <details>
                <summary>{{T "Add Category"}}</summary>
                <div>
        {{else}}
            [<a href="/sriracha/category/">{{T "Return"}}</a>]<br>
        {{end}}
        <form method="post">
            <fieldset>
            {{if ne .Manage.Category.ID 0}}<legend>{{T "Update"}} {{$name}}</legend>{{end}}
            <div class="managegrid">
                <div class="postblock"><label for="parent">{{T "Parent"}}</label></div>
                <div>
                    <select name="parent">
                        <option value="0"{{if eq .Manage.Category.Parent nil}} selected{{end}}>{{T "None"}}</option>
                        {{range $category := .Categories}}
                            <option value="{{.ID}}"{{if and (ne $.Manage.Category.Parent nil) (eq $.Manage.Category.Parent.ID $category.ID)}} selected{{end}}>{{if ne .Name ""}}{{.Name}}{{else}}Category #{{.ID}}{{end}}</option>
                        {{end}}
                    </select>
                </div>
                <div>{{T "Parent category."}}</div>

                <div class="postblock"><label for="name">{{T "Name"}}</label></div>
                <div><input type="text" name="name" value="{{.Manage.Category.Name}}"></div>
                <div>{{T "Displayed in site index."}}</div>

                <div class="postblock"><label for="description">{{T "Description"}}</label></div>
                <div><input type="text" name="description" value="{{.Manage.Category.Description}}"></div>
                <div>{{T "Optional."}}</div>

                <div class="postblock"><label for="overboard">{{T "Overboard"}}</label></div>
                <div><input type="text" name="overboard" value="{{.Manage.Category.Overboard}}"></div>
                <div>{{T "Directory where the overboard files are located. Leave blank to disable. To write the overboard at the root directory, enter \"/\"."}}</div>

                <div>&nbsp;</div>
                <div align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{if eq .Manage.Category.ID 0}}{{T "Add"}}{{else}}{{T "Update"}}{{end}}"></div>
                <div>&nbsp;</div>
            </div>
            </fieldset>
        </form>
        {{if eq .Manage.Category.ID 0}}
                </div>
            </details>
        {{end}}
    {{end}}
{{end}}
<br>
{{template "manage_end.gohtml" .}}
