{{if eq .Board.Type 0}}{{template "imgboard_begin.gohtml" .}}{{else}}{{template "forum_begin.gohtml" .}}{{end}}
{{/* Note: This template is included in forum_page.gohtml when replying to a thread. */}}
{{/* As a result, all template inclusions in this file must be conditional. */}}
{{if .Preview}}
	<div class="replymode">{{T "Posting mode: Preview"}}</div>
{{else if .ReplyMode}}
	<div class="replymode">
		{{if not .ModMode}}
			{{if not .ArchiveMode}}
				{{T "Posting mode: Reply"}}
			{{else}}
				{{T "Archive mode"}}
			{{end}}
		{{else}}
			{{if not .ArchiveMode}}
				{{T "Mod mode: Reply"}}
			{{else}}
				{{T "Mod mode: View"}}
			{{end}}
		{{end}}
	</div>
{{else if .ModMode}}
	<div class="replymode">{{T "Mod mode"}}</div>
{{end}}
{{if gt .Board.ID 0}}
	{{if ne .Message ""}}
		{{.Message}}
	{{else if $.Preview}}
		{{if eq .Extra "thumb"}}{{T "Only thumbnails are displayed."}}{{end}}
		{{T "Go back, uncheck '%s' and resubmit to post." (T "Preview")}}
	{{else if not .ArchiveMode}}
		<details id="postdetails">
			<summary>
				{{if eq .ReplyMode 0}}{{T "Post thread"}}{{else}}{{T "Post reply"}}{{end}}
				{{if ne .Opt.Refresh 0}}
					{{template "imgboard_page_status.gohtml" $}}
				{{end}}
			</summary>
			<div>
				{{if eq .Board.Type 0}}{{template "imgboard_postarea.gohtml" .}}{{else}}{{template "forum_postarea.gohtml" .}}{{end}}
			</div>
		</details>
	{{else if and .ReplyMode (gt (len .Threads) 0)}}
		{{T "Thread archived %s." (FormatTimestamp (index (index .Threads 0) 0).Bumped) | HTML}}
	{{end}}
{{end}}
<form method="post" action="/sriracha/">
	<input type="hidden" name="action" value="delete">
	<input type="hidden" name="board" value="{{.Board.Dir}}">
	{{if ne .ReplyMode 0}}
		<input type="hidden" name="thread" value="{{.ReplyMode}}">
	{{end}}
	<hr>
	<div>
		{{if eq .Board.Type 0}}{{template "imgboard_post.gohtml" $}}{{else}}{{template "forum_post.gohtml" $}}{{end}}
	</div>
	<hr>
	{{if not $.Preview}}
		<table class="userdelete">
			<tbody>
				<tr>
					<td>
						{{if $.ModMode}}
							<input type="submit" name="moderate" value="{{T "Moderate"}}">
						{{else}}
							{{T "Delete Post"}} <input type="password" name="password" id="deletepostpassword" size="8" placeholder="{{T "Password"}}" autocomplete="off">&nbsp;<input type="submit" id="deletepost" name="deletepost" value="{{T "Delete"}}">
						{{end}}
					</td>
				</tr>
			</tbody>
		</table>
	{{end}}
{{if eq .ReplyMode 0}}
	</form>
{{end}}
{{if not $.Preview}}
	<table class="navtable">
		<tbody>
			<tr>
				{{if eq .ReplyMode 0}}
					<td>{{if gt .Page 0}}<form method="get" action="{{if not $.ModMode}}{{.Board.Path}}{{if eq .Page 1}}{{if not .ArchiveMode}}index{{else}}archive{{end}}{{else}}{{if .ArchiveMode}}archive-{{.Page | MinusOne}}{{else}}{{.Page | MinusOne}}{{end}}{{end}}.html{{else}}/sriracha/board/mod/{{$.Board.ID}}{{if ne .Page 1}}p{{.Page | MinusOne}}{{end}}{{end}}">{{if and .ModMode .ArchiveMode}}<input type="hidden" name="archive" value="1">{{end}}<input type="submit" value="{{T "Previous"}}"></form>{{else}}{{T "Previous"}}{{end}}</td>
					<td>
						{{range $i := Iterate (.Pages | MinusOne)}}
							[{{if eq $i $.Page}}{{$i}}{{else}}<a href="{{if not $.ModMode}}{{$.Board.Path}}{{if eq $i 0}}{{if not $.ArchiveMode}}index{{else}}archive{{end}}{{else}}{{if $.ArchiveMode}}archive-{{$i}}{{else}}{{$i}}{{end}}{{end}}.html{{else}}/sriracha/board/mod/{{$.Board.ID}}{{if ne $i 0}}/p{{$i}}{{end}}{{if $.ArchiveMode}}?archive=1{{end}}{{end}}">{{$i}}</a>{{end}}]
						{{end}}
					</td>
					<td>{{if lt .Page (.Pages | MinusOne)}}<form method="get" action="{{if not $.ModMode}}{{.Board.Path}}{{if .ArchiveMode}}archive-{{.Page | PlusOne}}{{else}}{{.Page | PlusOne}}{{end}}.html{{else}}/sriracha/board/mod/{{$.Board.ID}}/p{{.Page | PlusOne}}{{end}}">{{if and .ModMode .ArchiveMode}}<input type="hidden" name="archive" value="1">{{end}}<input type="submit" value="{{T "Next"}}"></form>{{else}}{{T "Next"}}{{end}}</td>
				{{end}}
				{{if and .Opt.Notifications (gt .Board.ID 0) (not .ArchiveMode)}}
					{{if eq .ReplyMode 0}}
						<td style="border: 0px none;">&nbsp;</td>
					{{end}}
					<td style="border: 0px none;">
						{{if eq .ReplyMode 0}}
							<form method="get" action="/sriracha/subscribe/board/{{.Board.ID}}">
						{{end}}
						<input type="submit"{{if ne .ReplyMode 0}} name="subscribe"{{end}} value="{{T "Subscribe"}}">
						{{if eq .ReplyMode 0}}
							</form>
						{{end}}
					</td>
				{{end}}
				{{if and (ne .ReplyMode 0) (not .ArchiveMode)}}
					<td id="threadstatusdeleted" style="display: none;border: 0px none;color: red;font-weight: bold;">
						{{T "Thread deleted."}}
					</td>
				{{end}}
			</tr>
		</tbody>
	</table>
{{end}}
{{if ne .ReplyMode 0}}
	</form>
{{end}}
{{if eq .Board.Type 0}}{{template "imgboard_end.gohtml" .}}{{else}}{{template "forum_end.gohtml" .}}{{end}}
