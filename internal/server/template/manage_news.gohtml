{{template "manage_begin.gohtml" .}}
<h2 class="managetitle">{{T "News"}}</h2>
{{if ne (len .Manage.AllNews) 0}}
    <table class="managetable">
        <tr>
            <th>{{T "Subject"}}</th>
            <th>{{T "Author"}}</th>
            <th>{{T "Date"}}</th>
            <th>{{T "Action"}}</th>
        </tr>
        {{range $i, $news := .Manage.AllNews}}
            <tr>
                <td>{{if $news.Published}}<a href="/news-{{$news.ID}}.html">{{end}}{{if ne $news.Subject ""}}{{$news.Subject}}{{else}}{{T "No subject"}}{{end}}{{if $news.Published}}</a>{{end}}</td>
                <td>{{if ne $news.Account nil}}{{$news.Account.Username}}{{else}}{{T "None"}}{{end}}</td>
                <td>{{$news.DateLabel}}</td>
                <td>
                    {{if .MayUpdate $.Account}}
                        <form method="get" action="/sriracha/news/{{$news.ID}}"><input type="submit" value="{{T "Update"}}"></form>
                    {{else}}
                        <form method="get" action="/sriracha/news/{{$news.ID}}"><input type="submit" value="{{T "Details"}}"></form>
                    {{end}}
                    {{if .MayDelete $.Account}}
                        <form method="get" action="/sriracha/news/delete/{{$news.ID}}" onsubmit="return confirm('Delete {{if ne .Subject ""}}{{.Subject}}{{else}}news item #{{.ID}}{{end}}?');"><input type="submit" value="{{T "Delete"}}"></form>
                    {{end}}
                </td>
            </tr>
        {{end}}
    </table><br>
    {{if gt .Pages 1}}
        <table class="navtable">
            <tbody>
                <tr>
                    <td>
                        {{if gt .Page 0}}
                            <form method="get" action="/sriracha/news/{{if gt .Page 1}}p{{.Page | MinusOne}}{{end}}">
                                <input type="submit" value="{{T "Previous"}}">
                            </form>
                        {{else}}
                            {{T "Previous"}}
                        {{end}}
                    </td>
                    <td>
                        {{range $i := Iterate (.Pages | MinusOne)}}
                            [{{if eq $i $.Page}}{{$i}}{{else}}<a href="/sriracha/news/{{if gt $i 0}}p{{$i}}{{end}}">{{$i}}</a>{{end}}]
                        {{end}}
                    </td>
                    <td>
                        {{if lt .Page (.Pages | MinusOne)}}
                            <form method="get" action="/sriracha/news/p{{.Page | PlusOne}}">
                                <input type="submit" value="{{T "Next"}}">
                            </form>
                        {{else}}
                            {{T "Next"}}
                        {{end}}
                    </td>
                </tr>
            </tbody>
        </table><br><br>
    {{end}}
{{end}}
{{if eq .Manage.News nil}}
    <br>
    <details>
        <summary>{{T "Add News"}}</summary>
        <div>
{{else}}
    [<a href="/sriracha/news/">{{T "Return"}}</a>]<br>
{{end}}
<form method="post">
    <fieldset>
    {{if ne .Manage.News nil}}<legend>{{if .Manage.News.MayUpdate $.Account}}{{T "Update"}} {{end}}{{if ne .Manage.News.Subject ""}}{{.Manage.News.Subject}}{{else}}#{{.Manage.News.ID}}{{end}}</legend>{{end}}
    <table class="manageform">
        <tr>
            <td class="postblock"><label for="timestamp">{{T "Date"}}</label></td>
            <td><input type="text" name="timestamp" value="{{if ne .Manage.News nil}}{{.Manage.News.DateInput}}{{end}}"></td>
            <td>{{T "Date and time when the news item was published, or will be published."}} Format: <span style="border: 1px solid;padding: 2px;">YYYY/MM/DD HH:MM</span><br>
            {{T "Leave blank to hide until a date is set. News items with publish dates in the future are hidden until that date."}}</td>
        </tr>
        <tr>
            <td class="postblock"><label for="name">{{T "Name"}}</label></td>
            <td><input type="text" name="name" value="{{if ne .Manage.News nil}}{{.Manage.News.Name}}{{end}}"></td>
            <td>{{T "Optional."}}</td>
        </tr>
        <tr>
            <td class="postblock"><label for="subject">{{T "Subject"}}</label></td>
            <td><input type="text" name="subject" value="{{if ne .Manage.News nil}}{{.Manage.News.Subject}}{{end}}"></td>
            <td>{{T "Optional."}}</td>
        </tr>
        <tr>
            <td class="postblock"><label for="message">{{T "Message"}}</label></td>
            <td><textarea name="message" rows="4" cols="80">{{if ne .Manage.News nil}}{{.Manage.News.Message}}{{end}}</textarea>
            <td>{{T "HTML-formatted text."}}</td>
        </tr>
        {{if or (eq .Manage.News nil) (and (ne .Manage.News.Account nil) (eq .Manage.News.Account.ID .Account.ID))}}
            <tr>
                <td class="postblock"><label for="share">{{T "Share"}}</label></td>
                <td><select name="share" style="width: 100%;">
                    <option value="0"{{if and (ne .Manage.News nil) (not .Manage.News.Share)}} selected{{end}}>{{T "Do not share with staff"}}</option>
                    <option value="1"{{if and (ne .Manage.News nil) .Manage.News.Share}} selected{{end}}>{{T "Share with staff"}}</option>
                </select></td>
                <td>{{T "Shared news items may be updated by other staff members."}}</td>
            </tr>
        {{end}}
        {{if or (eq .Manage.News nil) (.Manage.News.MayUpdate .Account)}}
            <tr>
                <td>&nbsp;</td>
                <td align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{if eq .Manage.News nil}}{{T "Add"}}{{else}}{{T "Update"}}{{end}}"></td>
                <td>&nbsp;</td>
            </tr>
        {{end}}
    </table>
    </fieldset>
</form>
{{if eq .Manage.News nil}}
        </div>
    </details>
{{end}}
<br>
{{template "manage_end.gohtml" .}}
