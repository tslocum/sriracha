{{range $i, $thread := .Threads}}
	{{if gt $i 0}}
        <hr>
    {{end}}
    <div class="thread">
    {{range $i, $post := $thread}}
        {{if eq .Parent 0}}
            <div id="post{{.ID}}" class="op">
                <a id="{{.ID}}"></a>
                {{template "imgboard_post_attachment.gohtml" .}}
                {{template "imgboard_post_label.gohtml" (Slice $ $thread $post)}}
                <span class="threadui">{{if not $.ReplyMode}}{{if not $.ModMode}}&nbsp;[<a href="{{$post.Board.Path}}res/{{.Thread}}.html">{{T "Reply"}}</a>]{{else}}&nbsp;[<a href="/sriracha/board/mod/{{$post.Board.ID}}/{{.Thread}}">{{T "Reply"}}</a>]{{end}}{{else if and $post.Board.Gallery (HasExpandableMedia $thread)}}&nbsp;[<a href="#" onclick="javascript:openGallery();">{{T "Gallery"}}</a>]{{end}}</span>
                <div class="message">
                    {{if eq $.ReplyMode 0}}
                        {{.MessageTruncated 0 $.Account}}
                    {{else}}
                        {{.Message | HTML}}
                    {{end}}
                </div>
            </div>
            {{$omitted := Omitted .Board.Replies .Replies}}
            {{if and (eq $.ReplyMode 0) (gt $omitted 0)}}
                <span class="omittedposts">{{TN "%d post omitted. Click Reply to view." "%d posts omitted. Click Reply to view." $omitted $omitted}}</span>
            {{end}}
        {{else}}
            <table>
                <tbody>
                    <tr>
                        <td class="doubledash">
                            &#0168;
                        </td>
                        <td class="reply" id="post{{.ID}}">
                            <a id="{{.ID}}"></a>
                            {{template "imgboard_post_label.gohtml" (Slice $ $thread $post)}}
                            <br>
                            {{template "imgboard_post_attachment.gohtml" .}}
                            <div class="message">
                                {{if eq $.ReplyMode 0}}
                                    {{.MessageTruncated 0 $.Account}}
                                {{else}}
                                    {{.Message | HTML}}
                                {{end}}
                            </div>
                        </td>
                    </tr>
                </tbody>
            </table>
        {{end}}
    {{end}}
    </div>
{{end}}
