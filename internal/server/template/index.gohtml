{{template "imgboard_begin.gohtml" .}}
<style type="text/css">
hr {
    max-width: 930px;
}
.reply {
    border: 1px solid;
    box-shadow: 2px 2px;
    margin-top: 1.5rem;
    margin-bottom: 1.5rem;
	padding: 0.5rem;
}
td {
    vertical-align: top;
}
.navindex tr:not(:last-child):not(.category) td {
    padding-bottom: 1rem;
}
.boardtd {
    text-align: right;
    padding-right: 4px;
}
.msgtd {
    padding-left: 4px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
}
</style>
<div class="news">
    {{if ne .News nil}}
        <div style="text-align: center;margin-top: 0.75rem;margin-bottom: 1.5rem;">
            <div class="reply" style="display: inline-block;text-align: left;margin: 0;">
                <label style="cursor: pointer;">
                    <a href="/news.html" style="text-decoration: none;color: inherit;">
                        {{if ne .News.Subject ""}}<span class="filetitle">{{.News.Subject}}</span>{{end}}
                        {{if ne .News.Name ""}}<span class="postername">{{.News.Name}}</span>{{end}}
                        {{.News.DateLabel}}
                        <span class="reflink">
                            No.{{.News.ID}}
                        </span>
                    </a>
                </label><br>
                <div class="newsmessage">
                    {{.News.Message | HTML}}
                </div>
            </div>
        </div>
    {{end}}
    <hr>
    <div class="reply navindex">
        <table style="border: 0;table-layout: fixed;width: 100%;">
            {{$needSpacer := false}}
            {{range $i, $category := .Opt.Categories}}
                {{if eq (len $category.Boards) 0}}
                    {{continue}}
                {{else if ne $category.Name ""}}
                    <tr class="category">
                        <td class="boardtd">
                            <b>{{$category.Name}}</b>
                        </td>
                        <td>
                            {{if ne $category.Description ""}}{{$category.Description}}{{else}}&nbsp;{{end}}
                        </td>
                    </tr>
                {{end}}
                {{range $j, $board := $category.Boards}}
                    <tr>
                        <td class="boardtd">
                            <a href="{{.Path}}"><b>{{.Name}}</b></a>
                            {{if ne .Description ""}}<br>{{.Description}}{{end}}
                        </td>
                        <td colspan="2" class="msgtd">
                            {{$post := index $category.Recent $j}}
                            {{if eq $post nil}}
                                {{T "None"}}<br>&nbsp;
                            {{else}}
                                {{if eq $post nil}}
                                    {{T "None"}}<br>&nbsp;
                                {{else}}
                                    <label style="cursor: pointer;">
                                        <a href="{{$post.Board.Path}}res/{{$post.Thread}}.html#{{$post.ID}}" style="color: inherit;text-decoration: none;">
                                            {{$post.NameBlock | HTML}} No.{{$post.ID}}
                                        </a>
                                    </label>
                                    <br>
                                    {{$msg := $post.MessageTruncated 1 $.Account}}
                                    {{if eq $msg ""}}
                                        {{if ne $post.File ""}}
                                            {{if $post.IsEmbed}}
                                                {{T "Embed"}}
                                            {{else}}
                                                {{T "File"}}
                                            {{end}}
                                        {{else}}
                                            …
                                        {{end}}
                                    {{else}}
                                        {{$msg}}
                                    {{end}}
                                {{end}}
                            {{end}}
                        </td>
                    </tr>
                {{end}}
            {{end}}
        </table>
    </div>
</div>
<hr>
{{template "imgboard_end.gohtml" .}}
