{{template "imgboard_begin.gohtml" .}}
<style type="text/css">
hr {
    max-width: 930px;
}
</style>
<div class="news">
    {{if ne .News nil}}
        <div style="text-align: center;margin-top: 0.75rem;margin-bottom: 1.5rem;">
            <div class="reply newsentry" style="display: inline-block;text-align: left;margin: 0;">
                <label style="cursor: pointer;">
                    <a href="/news.html" style="text-decoration: none;color: inherit;">
                        {{if ne .News.Subject ""}}<span class="filetitle">{{.News.Subject}}</span>{{end}}
                        {{if ne .News.Name ""}}<span class="postername">{{.News.Name}}</span>{{end}}
                        {{.News.DateLabel}}
                    </a>
                </label><br>
                <div class="newsmessage">
                    {{.News.Message | HTML}}
                </div>
            </div>
        </div>
    {{end}}
    <hr>
    <div class="reply newsentry navindex">
        <div class="managegrid" style="grid-template-columns: auto 1fr 1fr; column-gap: 10px;">
            {{$needSpacer := false}}
            {{range $i, $category := .Opt.Categories}}
                {{if eq (len $category.Boards) 0}}
                    {{continue}}
                {{end}}
                {{if ne $category.Name ""}}
                    {{$needSpacer = true}}
                    <div class="navlabel">
                        <b>{{$category.Name}}</b>
                    </div>
                    <div class="navitem">
                        {{if ne $category.Description ""}}{{$category.Description}}{{else}}&nbsp;{{end}}
                    </div>
                {{end}}
                {{range $j, $board := $category.Boards}}
                    {{$needSpacer = true}}
                    <div class="navlabel">
                        <a href="{{.Path}}"><b>{{.Name}}</b></a>
                        {{if ne .Description ""}}<br>{{.Description}}{{end}}
                    </div>
                    <div class="navitem">
                        {{$post := index $category.Recent $j}}
                        {{if eq $post nil}}
                            …<br>…
                        {{else}}
                            <label style="cursor: pointer;">
                                <a href="{{$post.Board.Path}}res/{{$post.Thread}}.html#{{$post.ID}}" style="color: inherit;text-decoration: none;">
                                    {{if ne $post.Subject ""}}<span class="filetitle">{{$post.Subject}}</span>{{end}}
                                    {{$post.PlainNameBlock $post.Board.DefaultName "" false false}} No.{{$post.ID}}
                                </a>
                            </label>
                            <br>
                            {{$msg := $post.MessageTruncated 1 $.Account}}
                            {{if eq $msg ""}}
                                {{if ne $post.File ""}}
                                    {{if $post.IsEmbed}}
                                        {{T "Embed"}}
                                    {{else}}
                                        {{T "File"}}
                                    {{end}}
                                {{else}}
                                    …
                                {{end}}
                            {{else}}
                                {{$msg}}
                            {{end}}
                        {{end}}
                    </div>
                {{end}}
            {{end}}
        </div>
    </div>
</div>
<hr>
{{template "imgboard_end.gohtml" .}}
