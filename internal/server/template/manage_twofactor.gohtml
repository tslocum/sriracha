{{template "manage_begin.gohtml" .}}
<h2 class="managetitle">{{T "Two-Factor Authentication"}}</h2>
[<a href="/sriracha/preference/">{{T "Return"}}</a>]<br>
<fieldset>
    <legend>{{T "%s Devices" "2FA"}}</legend>
    <table class="manageform">
        {{if gt (len .Manage.TwoFactors) 0}}
            <tr><th>{{T "Device"}}</th><th>{{T "Added"}}</th><th>{{T "Used"}}</th><th>{{T "Action"}}</th></tr>
            {{range $i, $twoFactor := .Manage.TwoFactors}}
                <tr><td class="postblock">{{if ne $twoFactor.Name ""}}{{$twoFactor.Name}}{{else}}#{{$twoFactor.ID}}{{end}}</td><td>2026/07/15</td><td>2026/07/15</td><td>[Rename] [Delete]</td></tr>
            {{end}}
        {{else}}
            <tr><td colspan="3">{{T "No two-factor authentication devices."}}</td></tr>
        {{end}}
        <tr><td colspan="3" align="right"><input type="submit" class="managebutton" style="width: auto;min-width: 50%;" value="{{T "Add %s Device" "2FA"}}"></td></tr>
    </table>
</fieldset><br>
{{template "manage_end.gohtml" .}}
